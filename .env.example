# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit your real keys.

# --- Anthropic (Claude API) --------------------------------------------------
# Used by:
#   - scripts/build_training_set.py (synthesizes training dialogues)
#   - src/evaluation/llm_judge.py    (Depth/Actionability rubric scoring)
#   - scripts/build_decision_tree.py (drafts cartographie content)
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Ollama (local inference) ------------------------------------------------
# Override only if your Ollama server is not on the default host/port.
HERA_OLLAMA_URL=http://localhost:11434
HERA_OLLAMA_MODEL=mistral:7b-instruct-v0.3-q4_K_M
# After J4 (fine-tune merge + GGUF q4 import), switch to:
#   HERA_OLLAMA_MODEL=hera-baseline:latest

# --- Embeddings for RAG (optional, local default) ----------------------------
# Default: BAAI/bge-small-en-v1.5 downloaded on first run, no key needed.
# Uncomment to use OpenAI embeddings instead.
# OPENAI_API_KEY=
# HERA_EMBEDDING_MODEL=text-embedding-3-small

# --- Web app (already wired in web/backend/app/config.py) --------------------
HERA_HOST=127.0.0.1
HERA_PORT=8000
HERA_SESSION_LIFETIME_HOURS=12
HERA_REMEMBER_ME_LIFETIME_DAYS=30
HERA_LOGIN_MAX_ATTEMPTS=5
HERA_LOGIN_WINDOW_MINUTES=15
