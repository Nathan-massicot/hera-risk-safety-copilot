  {
    "id": "scenario_23",
    "app_description": "InflamaTrack is a journal for IBD (Crohn's, ulcerative colitis) patients: stool frequency, urgency, bleeding, food triggers. Anonymized data is shared with a gastroenterology research consortium (opt-in). EU + CH.",
    "app_metadata": {"category": "chronic-condition", "uses_ai": false, "data_sensitivity": "high", "vulnerable_pop": false, "target_markets": ["EU", "CH"], "samd_class_likely": "Class I"},
    "developer_persona": "Research-affiliated startup; sometimes blurs research/product lines.",
    "simulated_answers": {
      "data_collected": "Symptom logs (frequency, severity, bleeding), food triggers, medication adherence, mood, biometrics from wearable (optional).",
      "consent_flow": "Two-layer: app usage + research consortium opt-in (with detailed PIS).",
      "regulatory_status": "Class I; research arm IRB-approved.",
      "user_research": "Co-designed with IBD patient association.",
      "accessibility": "WCAG; DE/FR/IT/EN.",
      "safety_validation": "Symptom logging is observational; no claims.",
      "ai_or_algorithm": "No AI.",
      "post_market": "Annual safety review.",
      "data_sharing": "Anonymized data to research consortium with explicit opt-in; aggregated reports to patients.",
      "withdrawal_rights": "Withdraw from research at any time; future data not shared; published data remains as published."
    },
    "gold_standard": {
      "relevant_dimensions": ["P2.D1", "P2.D4", "P2.D5", "P2.D6", "P3.D4", "P4.D2", "P5.D2", "P5.D3", "P6.D2", "P7.D4"],
      "expected_risks": [
        {"dimension": "P2.D5", "risk": "'Anonymized' IBD data can be re-identified via symptom pattern + medication + geographic info; k-anonymity threshold must be set.", "severity": "high"},
        {"dimension": "P3.D4", "risk": "Right to withdraw must be granular: 'don't share my data with the consortium any more' AND 'delete previously shared data where possible'.", "severity": "high"},
        {"dimension": "P2.D6", "risk": "IBD symptoms (bleeding, stool) are highly intimate; data leak has stigmatizing potential.", "severity": "medium"},
        {"dimension": "P2.D4", "risk": "Research-consortium partners: how many, who, where? List should be visible to user.", "severity": "medium"},
        {"dimension": "P5.D3", "risk": "Audit log of who accessed user's data in the consortium must be available to user.", "severity": "medium"},
        {"dimension": "P5.D2", "risk": "User must understand what 'opt in to research' actually means and how it differs from 'use the app'.", "severity": "medium"}
      ],
      "expected_mitigations": [
        {"dimension": "P2.D5", "mitigation": "Use HE / synthetic data or k≥50 anonymization; audit by external statistician."},
        {"dimension": "P3.D4", "mitigation": "Dynamic consent dashboard; per-partner opt-out; clear language about what can/cannot be undone."},
        {"dimension": "P2.D4", "mitigation": "Live list of research partners + their purpose + how to contact them; updated within 24h."},
        {"dimension": "P5.D3", "mitigation": "Per-user access log: who, when, what data."}
      ],
      "expected_regulations_cited": ["GDPR Art. 9", "GDPR Art. 89 (research)", "Recital 33 (research consent)", "MDR 2017/745", "Swiss HRA (Human Research Act)"]
    },
    "notes": "Patient-research overlap; tests for re-identification risk, dynamic consent, and audit access."
  },
  {
    "id": "scenario_24",
    "app_description": "VoiceMind is a hospital-waiting-room kiosk that records a 60-second voice sample, runs an ML model that flags depression risk, and notifies the front desk to suggest an appointment. Designed for primary-care clinics. EU.",
    "app_metadata": {"category": "ai-clinical", "uses_ai": true, "data_sensitivity": "high", "vulnerable_pop": true, "target_markets": ["EU"], "samd_class_likely": "IIa"},
    "developer_persona": "AI researcher founder, technically strong, regulation-fluent on paper.",
    "simulated_answers": {
      "data_collected": "60-second audio, ML model output (risk score), front-desk action.",
      "consent_flow": "Patient signs consent on the kiosk before recording.",
      "regulatory_status": "Class IIa SaMD under MDR; CE marking in progress.",
      "user_research": "Tested with 5 primary-care clinics.",
      "accessibility": "Voice-only is exclusionary for users with speech difficulties.",
      "safety_validation": "Validation N=400 patients vs PHQ-9; AUROC 0.82.",
      "ai_or_algorithm": "Speech model (Wav2Vec) + classifier head.",
      "post_market": "Quarterly performance review; vigilance reporting.",
      "data_sharing": "Audio kept 7 days for incident review; embeddings retained 1 year.",
      "withdrawal_rights": "Patient can request audio deletion."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D2", "P1.D4", "P2.D1", "P2.D3", "P2.D6", "P3.D1", "P3.D5", "P4.D3", "P5.D1", "P5.D2", "P5.D4", "P6.D1", "P6.D3", "P7.D1", "P7.D3", "P7.D5"],
      "expected_risks": [
        {"dimension": "P2.D1", "risk": "Consent in a waiting room is coercive; user can't easily refuse a kiosk in front of receptionist + queue.", "severity": "high"},
        {"dimension": "P2.D6", "risk": "Mental-health flagging in a public-ish space → social stigma + potential overheard front-desk discussion.", "severity": "high"},
        {"dimension": "P6.D1", "risk": "Voice models are sensitive to accent, language, age; AUROC 0.82 overall may hide much worse subgroup performance.", "severity": "high"},
        {"dimension": "P5.D2", "risk": "Front desk sees a risk score with no clinical context; may over-trigger appointments.", "severity": "high"},
        {"dimension": "P3.D5", "risk": "Front-desk staff are not clinicians; risk of automation bias driving inappropriate handling.", "severity": "high"},
        {"dimension": "P4.D3", "risk": "Voice-only excludes users with speech impairments, severe accent, language other than supported.", "severity": "high"},
        {"dimension": "P2.D3", "risk": "Audio retention 7 days in a kiosk environment — physical security?", "severity": "medium"},
        {"dimension": "P5.D1", "risk": "Black-box risk score; clinician needs to know why this patient was flagged.", "severity": "medium"}
      ],
      "expected_mitigations": [
        {"dimension": "P2.D1", "mitigation": "Private consent flow in a separate room; explicit 'No, thanks' option that is not visible to staff."},
        {"dimension": "P6.D1", "mitigation": "Subgroup evaluation by accent/age/sex; refuse to score outside validated language scope."},
        {"dimension": "P3.D5", "mitigation": "Front desk never sees raw score; only a 'consider asking the patient if they'd like to talk to someone' suggestion."},
        {"dimension": "P4.D3", "mitigation": "Alternative consent path: text-based PHQ-9 on the kiosk; user can choose."},
        {"dimension": "P5.D1", "mitigation": "Clinician dashboard shows top driving voice features (pitch variability, speech rate) with caveats."}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Rule 11", "EU AI Act Annex III §1(a)", "EU AI Act Art. 5 (manipulative/exploitative if pressure)", "GDPR Art. 9", "GDPR Art. 7 (consent)", "Council of Europe Convention 108"]
    },
    "notes": "Stigma + consent-in-waiting-room + bias + automation bias by non-clinicians. Many high-stakes catches."
  },
