      "accessibility": "DE/FR/IT/EN; large fonts.",
      "safety_validation": "Schedule mirrors BAG; we update when BAG updates.",
      "ai_or_algorithm": "No AI.",
      "post_market": "Annual BAG calendar refresh.",
      "data_sharing": "None.",
      "withdrawal_rights": "Account delete."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D5", "P2.D1", "P2.D2", "P2.D6", "P4.D5", "P5.D2", "P6.D2", "P7.D1", "P7.D4"],
      "expected_risks": [
        {"dimension": "P1.D5", "risk": "If BAG updates the calendar (e.g., new vaccine, change of timing) and the app's data isn't refreshed promptly, missed vaccinations occur.", "severity": "high"},
        {"dimension": "P2.D6", "risk": "Children's data; consent flow for parental responsibility must be robust.", "severity": "high"},
        {"dimension": "P4.D5", "risk": "Offline use case (rural CH) — does the app need internet to compute the next reminder?", "severity": "medium"},
        {"dimension": "P5.D2", "risk": "Vaccine hesitancy: app must clearly say 'this is a reminder, not a medical recommendation specific to your child'.", "severity": "medium"},
        {"dimension": "P7.D1", "risk": "Could be Class I SaMD if interpreted as patient-specific medical advice; safer to mirror BAG exactly.", "severity": "low"},
        {"dimension": "P2.D2", "risk": "Email collection for free reminder; could use just local notifications.", "severity": "low"}
      ],
      "expected_mitigations": [
        {"dimension": "P1.D5", "mitigation": "Subscribe to BAG calendar feed; flag stale data in UI; force update on launch if >30 days old."},
        {"dimension": "P2.D6", "mitigation": "Parental consent + capacity to opt-out child once age of consent reached (CH varies)."},
        {"dimension": "P4.D5", "mitigation": "Pre-compute all reminders offline at install; sync only when calendar updates."},
        {"dimension": "P5.D2", "mitigation": "Onboarding screen: 'This is the official BAG calendar. Talk to your paediatrician about your child's specific situation.'"}
      ],
      "expected_regulations_cited": ["Swiss BAG/Bundesamt für Gesundheit vaccination calendar", "Swiss nLPD", "MedDO/ODim", "GDPR Art. 8 (child consent)", "MDR 2017/745 Rule 11"]
    },
    "notes": "Simple Swiss-flavoured paediatric scenario; tests for staleness detection, offline robustness, and respect for parental autonomy + clinician primacy."
  }
