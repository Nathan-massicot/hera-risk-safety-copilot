[
  {
    "id": "scenario_01",
    "app_description": "Hi, I'm building a mental-health chatbot called SerenityBot. It uses an LLM (we fine-tuned Mistral-7B) to deliver CBT exercises for users with mild-to-moderate anxiety. Users chat with it daily, log their mood, and the bot adapts its responses based on past sessions. We're targeting young adults (18-30) in France and Switzerland. There's a crisis-keyword detector that pops up a hotline number.",
    "app_metadata": {"category": "mental-health", "uses_ai": true, "data_sensitivity": "high", "vulnerable_pop": true, "target_markets": ["EU", "CH"], "samd_class_likely": "IIa"},
    "developer_persona": "Junior product manager at a 12-person startup, technically curious but light on regulation knowledge. Defensive when scope creep into 'medical device' territory is suggested.",
    "simulated_answers": {
      "data_collected": "We store chat transcripts, mood scores, session timestamps, and anonymized usage metrics. We don't ask for name or address, just email for login.",
      "consent_flow": "There's a checkbox at signup saying 'I agree to the terms'. The privacy policy is a 14-page PDF.",
      "regulatory_status": "We're calling it a wellness app to avoid medical device classification. Our legal counsel said as long as we put 'not a substitute for therapy' in the disclaimer, we're fine.",
      "user_research": "We did 8 interviews with potential users during design. No clinical psychologist on the team yet, but our CEO is talking to one.",
      "accessibility": "We support French and English. We haven't tested with screen readers or users with cognitive impairments.",
      "safety_validation": "We A/B tested the crisis-keyword detector against a held-out set of 200 messages flagged manually. F1 was 0.74.",
      "ai_or_algorithm": "The LLM is Mistral-7B fine-tuned on ~10k CBT-style dialogues we generated synthetically using GPT-4. We do post-hoc moderation with a smaller classifier.",
      "post_market": "We have crash analytics via Sentry. No clinical incident reporting workflow.",
      "data_sharing": "We share aggregated usage stats with our investor. Chat content stays internal.",
      "withdrawal_rights": "Users can delete their account from settings, which deletes all their data after 30 days."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D1", "P1.D2", "P1.D3", "P1.D4", "P2.D1", "P2.D6", "P3.D2", "P3.D3", "P5.D2", "P5.D4", "P6.D3", "P7.D1", "P7.D2", "P7.D3", "P7.D5"],
      "expected_risks": [
        {"dimension": "P7.D1", "risk": "Almost certainly a Software as a Medical Device (SaMD) under MDR — the disclaimer doesn't change the intended purpose. CBT delivery to users with anxiety is a medical intent.", "severity": "high"},
        {"dimension": "P7.D3", "risk": "Likely high-risk under EU AI Act (Annex III §1 health), requires conformity assessment, post-market monitoring, transparency.", "severity": "high"},
        {"dimension": "P1.D1", "risk": "No clinical validation of the CBT exercises or the chatbot's adherence to evidence-based protocols.", "severity": "high"},
        {"dimension": "P2.D1", "risk": "Consent is a single checkbox over a 14-page PDF — not informed consent for processing sensitive health data under GDPR Art. 9.", "severity": "high"},
        {"dimension": "P2.D6", "risk": "Young adults can include 18-year-olds with maturing autonomy; chat transcripts are special-category data.", "severity": "medium"},
        {"dimension": "P1.D4", "risk": "Users with anxiety may use the bot as a substitute for professional care; no escalation to a clinician.", "severity": "high"},
        {"dimension": "P3.D2", "risk": "Daily engagement loop + mood logging may cultivate dependency or emotional reliance on the bot.", "severity": "medium"},
        {"dimension": "P5.D2", "risk": "Disclaimer is buried; users may not understand the bot is not a therapist.", "severity": "high"},
        {"dimension": "P5.D4", "risk": "CBT exercises generated by an LLM may not be distinguishable from validated clinical content.", "severity": "high"},
        {"dimension": "P6.D3", "risk": "French/English only — Switzerland has German + Italian speakers; no cultural validation of CBT prompts.", "severity": "medium"}
      ],
      "expected_mitigations": [
        {"dimension": "P7.D1", "mitigation": "Engage a Notified Body, classify as Class IIa SaMD under MDR Rule 11, prepare a technical file."},
        {"dimension": "P7.D3", "mitigation": "Map system to EU AI Act high-risk obligations: risk-management system, data governance docs, human oversight, transparency to users."},
        {"dimension": "P1.D1", "mitigation": "Run a single-arm pilot study with 50-100 users + standardized anxiety scale (GAD-7) pre/post, with a clinician on the team."},
        {"dimension": "P2.D1", "mitigation": "Layered consent UI: short summary + 'tell me more' expansions; separate consent for crisis-keyword detection and research use."},
        {"dimension": "P1.D4", "mitigation": "Mandatory weekly self-assessment; if GAD-7 ≥ 10 for 2 consecutive weeks, surface a 'please consider seeing a professional' nudge."},
        {"dimension": "P5.D4", "mitigation": "Visibly tag content as 'AI-generated CBT guidance' vs 'clinically reviewed' modules."}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Rule 11", "EU AI Act Annex III §1(a)", "GDPR Art. 9", "GDPR Art. 7", "ISO 82304-2", "MDCG 2019-11"]
    },
    "notes": "Highest-stakes scenario: developer assumes 'disclaimer = not a medical device' (false). Must catch SaMD classification, EU AI Act, and lack of clinical validation. Crisis path is necessary but not sufficient."
  },
  {
    "id": "scenario_02",
    "app_description": "I'm a senior engineer at MedTech AG. We built GlucoCare, a diabetes management app for Type 1 and Type 2 patients in Switzerland and Germany. Patients log glucose readings from any meter, log carbs, log insulin doses; the app shows trends and exports PDF reports for their endocrinologist. No dose recommendations, no automation. We have a CE-marked Class I device today.",
    "app_metadata": {"category": "chronic-condition", "uses_ai": false, "data_sensitivity": "high", "vulnerable_pop": false, "target_markets": ["EU", "CH"], "samd_class_likely": "IIa"},
    "developer_persona": "Senior software engineer, comfortable with technical detail and regulation. May understate clinical risk because the app 'just logs'.",
    "simulated_answers": {
      "data_collected": "Glucose readings (mg/dL), insulin doses, meal carbs, exercise log, weight, optionally HbA1c when patient enters it.",
      "consent_flow": "On first launch, user reads a 1-page consent summary, taps Accept. Health-data processing has a separate explicit toggle.",
      "regulatory_status": "Class I MDD legacy, currently going through MDR transition. We've assumed Rule 11 still puts us in Class I but it might bump to IIa.",
      "user_research": "Beta tested with 80 patients over 6 months at a Zürich endocrinology clinic.",
      "accessibility": "German, French, Italian, English. WCAG 2.1 AA audit passed. Tested with low-vision users.",
      "safety_validation": "Glucose entry validation: warns if reading is below 50 or above 400. No dose calculations.",
      "ai_or_algorithm": "No AI. Trend display is just moving averages.",
      "post_market": "We have a PMS plan, a complaints inbox, and a vigilance reporting workflow with Swissmedic.",
      "data_sharing": "Data stays on device + encrypted backup in our EU AWS region. Endocrinologist gets PDFs only when patient sends them.",
      "withdrawal_rights": "Account deletion wipes server-side data within 30 days. Local data is wiped on app uninstall."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D5", "P1.D6", "P2.D1", "P2.D3", "P4.D1", "P4.D2", "P4.D5", "P7.D1", "P7.D2", "P7.D4", "P7.D5", "P7.D7"],
      "expected_risks": [
        {"dimension": "P7.D1", "risk": "MDR Rule 11 likely bumps to Class IIa — software intended to provide info used for decisions with diagnostic or therapeutic purposes (diabetes management informs dosing decisions by the patient).", "severity": "high"},
        {"dimension": "P1.D5", "risk": "If glucose readings are imported via OCR or BLE without verification, measurement-source reliability matters more than entry validation.", "severity": "medium"},
        {"dimension": "P1.D6", "risk": "Patients may rely on trend display to decide insulin doses without consulting physician.", "severity": "medium"},
        {"dimension": "P4.D2", "risk": "PDF export is one-way; lack of FHIR-based exchange limits clinical integration.", "severity": "low"},
        {"dimension": "P4.D5", "risk": "Patients with no internet can't sync; if a critical safety update is needed, slow updates delay risk mitigation.", "severity": "medium"},
        {"dimension": "P7.D4", "risk": "EU AWS region is good; but cross-border processing UE/CH needs SCCs since CH adequacy is unilateral.", "severity": "low"}
      ],
      "expected_mitigations": [
        {"dimension": "P7.D1", "mitigation": "Re-classify as IIa under MDR Rule 11, prepare a Notified Body submission, run a clinical evaluation."},
        {"dimension": "P1.D6", "mitigation": "Display a prominent banner: 'Do not change insulin doses without consulting your physician.'"},
        {"dimension": "P4.D2", "mitigation": "Expose FHIR R4 endpoints for Observation (glucose, HbA1c) so EHRs can pull data."},
        {"dimension": "P4.D5", "mitigation": "Critical safety updates pushed via FCM/APNS as mandatory, with offline-friendly fallback."}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Rule 11", "MDCG 2019-11", "ISO 82304-2", "GDPR Art. 9", "Swiss nLPD", "MedDO/ODim", "FHIR R4"]
    },
    "notes": "Realistic case: mature dev, the right reflex is to confirm MDR re-classification and tighten FHIR interop. Less about consent (already good) more about clinical decision support boundary."
  },
  {
    "id": "scenario_03",
    "app_description": "We are launching TriageAI, an LLM-based symptom checker. The user enters symptoms in natural language, the model asks 3-5 follow-ups, then outputs a triage recommendation: self-care, GP appointment, urgent care, or call 112. We use Llama 3.1 70B hosted on our EU servers. Our disclaimer says 'TriageAI is not a medical device, results are informational only.' We target the EU consumer market via App Store and Google Play.",
    "app_metadata": {"category": "ai-clinical", "uses_ai": true, "data_sensitivity": "high", "vulnerable_pop": false, "target_markets": ["EU", "CH"], "samd_class_likely": "IIa-IIb"},
    "developer_persona": "Tech founder confident in the model's capabilities, evasive about medical device classification. Quick to cite NHS 111 as precedent.",
    "simulated_answers": {
      "data_collected": "Symptoms entered as free text, age, gender, postcode (for routing). No name, no ID.",
      "consent_flow": "Two checkboxes: terms of service and 'I understand this is not medical advice'.",
      "regulatory_status": "We avoid SaMD by labelling as informational. NHS 111 online does the same triage and is not classified as a medical device.",
      "user_research": "Internal team tested ~200 cases against medical textbooks. Accuracy 78% on top-1 triage level.",
      "accessibility": "English, French, German, Spanish. Mobile-first responsive.",
      "safety_validation": "Compared 500 outputs to a panel of 3 GPs. Top-1 agreement 71%, under-triage rate 8% for chest pain category.",
      "ai_or_algorithm": "Llama 3.1 70B with a system prompt + a small RAG layer of UK NHS triage guidelines.",
      "post_market": "We log every interaction. No formal incident review.",
      "data_sharing": "No third-party sharing. Logs used to improve the model.",
      "withdrawal_rights": "Anonymous use — no account, no data to delete server-side beyond logs (which we keep 12 months for retraining)."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D1", "P1.D2", "P1.D3", "P1.D5", "P2.D1", "P2.D2", "P2.D6", "P5.D1", "P5.D2", "P5.D3", "P5.D4", "P6.D1", "P6.D3", "P7.D1", "P7.D2", "P7.D3", "P7.D5"],
      "expected_risks": [
        {"dimension": "P7.D1", "risk": "Triage recommendation is intended purpose of diagnostic decision support → SaMD under MDR. 'Informational' label does not change intended purpose (MDCG 2019-11).", "severity": "high"},
        {"dimension": "P7.D3", "risk": "EU AI Act Annex III §1(a) high-risk: AI in healthcare triage. Conformity assessment + CE marking required.", "severity": "high"},
        {"dimension": "P1.D2", "risk": "8% under-triage on chest pain is unacceptable (cardiac MIs missed → death). Requires re-design of high-severity branches.", "severity": "high"},
        {"dimension": "P1.D1", "risk": "Validation against 3 GPs on 500 cases is far below the evidence bar (NICE ESF tier 3 = comparative study ≥1000 cases or RCT).", "severity": "high"},
        {"dimension": "P5.D2", "risk": "Two checkboxes do not convey the 8% under-triage rate.", "severity": "high"},
        {"dimension": "P6.D1", "risk": "Llama trained on US/UK medical data; symptom presentation varies by gender/ethnicity (e.g., MI in women), no fairness audit.", "severity": "high"},
        {"dimension": "P2.D2", "risk": "Storing free-text symptoms 12 months is excessive — pseudonymous but reversible via postcode + symptom + age triangulation.", "severity": "medium"},
        {"dimension": "P5.D3", "risk": "No decision logs visible to user or auditor; cannot explain why a given recommendation was made.", "severity": "medium"}
      ],
      "expected_mitigations": [
        {"dimension": "P7.D1", "mitigation": "Submit to Notified Body as Class IIa/IIb SaMD under MDR Rule 11."},
        {"dimension": "P1.D2", "mitigation": "Implement a deterministic safety net: any mention of chest pain / SOB / weakness on one side / loss of consciousness → mandatory 'call 112' override regardless of LLM output."},
        {"dimension": "P1.D1", "mitigation": "Multi-site prospective cohort study with N≥1000 across EU populations before launch; comparator = standard care."},
        {"dimension": "P6.D1", "mitigation": "Sex/ethnicity-stratified evaluation of triage accuracy; document gaps in model card."},
        {"dimension": "P2.D2", "mitigation": "Retain symptom logs ≤ 30 days unless user opts in to longer for research; strong pseudonymization (drop postcode for retained logs)."}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Rule 11", "MDCG 2019-11", "EU AI Act Annex III §1(a)", "NICE Evidence Standards Framework", "GDPR Art. 9", "GDPR Art. 25"]
    },
    "notes": "Classic 'disclaimer doesn't save you' case + AI Act high-risk + under-triage as life-threatening. Must catch all three."
  },
  {
    "id": "scenario_04",
    "app_description": "I'm building BumpGuide, a pregnancy tracker app. Users enter their LMP date, the app shows week-by-week fetal development, lets them log symptoms, count kicks, and time contractions. Free version is ad-supported with display ads from a major ad network; premium removes ads. We target EU + CH. Available in 12 languages.",
    "app_metadata": {"category": "reproductive", "uses_ai": false, "data_sensitivity": "high", "vulnerable_pop": true, "target_markets": ["EU", "CH"], "samd_class_likely": "Class I or wellness"},
    "developer_persona": "Indie developer running a small mobile-app company. Cost-sensitive, monetization-focused.",
    "simulated_answers": {
      "data_collected": "Email, LMP date, birth date for due-date calc, symptoms log, kick counts. We also use IDFA / Android ad ID for the ad network.",
      "consent_flow": "Standard EU consent banner: Accept All / Reject / Customize. Privacy policy linked.",
      "regulatory_status": "It's a wellness/lifestyle app, no medical advice given, no SaMD.",
      "user_research": "We A/B test designs continuously, no formal user research with pregnant users.",
      "accessibility": "12 languages via Crowdin. WCAG basics, no audit.",
      "safety_validation": "Fetal development content reviewed by 1 OB-GYN consultant 3 years ago.",
      "ai_or_algorithm": "No AI. Contractions timer uses a hard-coded 5-1-1 rule for 'go to hospital'.",
      "post_market": "App Store reviews monitored, no clinical incident workflow.",
      "data_sharing": "Ad network gets device ID + behavioral signals. Aggregated usage to analytics provider (Firebase).",
      "withdrawal_rights": "Account delete in settings."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D5", "P2.D1", "P2.D2", "P2.D3", "P2.D4", "P2.D6", "P3.D2", "P4.D4", "P5.D2", "P6.D2", "P7.D1", "P7.D4"],
      "expected_risks": [
        {"dimension": "P2.D4", "risk": "Sharing device IDs + pregnancy-related behavioral signals with an ad network is profiling of special-category data under GDPR Art. 9 + Art. 22.", "severity": "high"},
        {"dimension": "P2.D6", "risk": "Pregnancy data is highly sensitive (loss, miscarriage detection). Ad-targeting can lead to ads after miscarriage — major emotional harm.", "severity": "high"},
        {"dimension": "P2.D1", "risk": "Cookie banner consent ≠ explicit Art. 9 consent for processing health data for advertising.", "severity": "high"},
        {"dimension": "P2.D2", "risk": "Email collection unnecessary for core functionality; ad ID + LMP enables fingerprinting.", "severity": "medium"},
        {"dimension": "P7.D1", "risk": "5-1-1 rule for 'go to hospital' is a clinical decision support feature — arguably SaMD intended purpose.", "severity": "medium"},
        {"dimension": "P1.D5", "risk": "Fetal development info 3 years old, never re-reviewed; medical guidance can change.", "severity": "medium"},
        {"dimension": "P3.D2", "risk": "Engagement-optimized notifications can pressure users in vulnerable moments.", "severity": "medium"},
        {"dimension": "P6.D2", "risk": "12 languages is good for reach but does the content meet local standards (FR vs DE vs IT clinical norms)?", "severity": "low"}
      ],
      "expected_mitigations": [
        {"dimension": "P2.D4", "mitigation": "Remove ad network for health data context; switch monetization to subscription or contextual ads (no behavioral)."},
        {"dimension": "P2.D6", "mitigation": "Implement a 'pregnancy loss' state that immediately stops engagement notifications and ads."},
        {"dimension": "P2.D1", "mitigation": "Two-step consent: account creation + explicit consent for processing pregnancy data with full disclosure of recipients."},
        {"dimension": "P7.D1", "mitigation": "Either remove the contractions decision rule, or pursue Class I SaMD registration with a Notified Body declaration."},
        {"dimension": "P1.D5", "mitigation": "Annual medical content review with a current OB-GYN; document review dates in-app."}
      ],
      "expected_regulations_cited": ["GDPR Art. 9", "GDPR Art. 22", "ePrivacy Directive", "MDR 2017/745 Rule 11", "MDCG 2019-11"]
    },
    "notes": "Pregnancy + ads = headline-risk territory. Must catch ad ID + health data combo, miscarriage state, and the borderline SaMD aspect."
  },
  {
    "id": "scenario_05",
    "app_description": "MigraineSense logs your headache episodes plus context like weather, sleep, stress level, food triggers. A small ML model predicts the next likely migraine window over 48h. We use a gradient boosted model trained on 2000 user-years of data. Available in EU. Disclaimer says predictions are 'informational'.",
    "app_metadata": {"category": "self-report", "uses_ai": true, "data_sensitivity": "medium", "vulnerable_pop": false, "target_markets": ["EU"], "samd_class_likely": "Class I or IIa"},
    "developer_persona": "Data scientist who built the ML model. Knows ML deeply but light on regulation. Skeptical that prediction = medical device.",
    "simulated_answers": {
      "data_collected": "Headache logs (intensity, location, duration), sleep from HealthKit/Google Fit if user grants, location for weather lookup, food triggers from user-entered text, mood (1-5 scale).",
      "consent_flow": "Onboarding sequence with separate toggles for sleep data, location, food data.",
      "regulatory_status": "Disclaimer says informational. We're a wellness app.",
      "user_research": "Pre-launch survey of 300 migraine sufferers, focus groups with 12.",
      "accessibility": "English, French, German, Spanish. Large-text mode.",
      "safety_validation": "Model validated on held-out 20% split: precision 0.62, recall 0.41 on 48h window.",
      "ai_or_algorithm": "XGBoost on user-engineered features. Per-user fine-tuning after 30 logs.",
      "post_market": "Sentry crash analytics. Model performance monitored monthly via dashboard, no automated rollback.",
      "data_sharing": "Aggregated patterns shared with a research partnership with a neurology dept.",
      "withdrawal_rights": "Delete account → data erased within 14 days. Research data is pseudonymized."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D1", "P1.D3", "P1.D5", "P2.D1", "P2.D5", "P5.D1", "P5.D2", "P5.D3", "P5.D4", "P6.D5", "P7.D1", "P7.D3"],
      "expected_risks": [
        {"dimension": "P1.D3", "risk": "Predictions with 41% recall mean 59% of migraines occur outside predicted windows; users may discount real-world symptoms because the model didn't predict.", "severity": "high"},
        {"dimension": "P5.D2", "risk": "Precision/recall not communicated to users; they see a confident prediction without uncertainty.", "severity": "high"},
        {"dimension": "P7.D3", "risk": "Health-domain AI prediction → check whether high-risk under EU AI Act Annex III §1(a). Likely yes if marketed for clinical use.", "severity": "medium"},
        {"dimension": "P7.D1", "risk": "If predictions are used to take preventive medication, this becomes a SaMD (clinical decision support).", "severity": "medium"},
        {"dimension": "P5.D1", "risk": "No explanation of what features drove the prediction — XGBoost feature importances not surfaced.", "severity": "medium"},
        {"dimension": "P6.D5", "risk": "Training data sample of 2000 user-years — diversity in age, gender, migraine type unclear.", "severity": "medium"},
        {"dimension": "P1.D1", "risk": "Held-out 20% same-distribution split doesn't generalize; no prospective study.", "severity": "medium"},
        {"dimension": "P2.D5", "risk": "Pseudonymized research data — easily re-identifiable via sleep + location + headache pattern combo.", "severity": "low"}
      ],
      "expected_mitigations": [
        {"dimension": "P1.D3", "mitigation": "Display prediction with confidence + advice: 'Even outside predicted windows, log any symptoms as usual.'"},
        {"dimension": "P5.D2", "mitigation": "Always show recall/precision in user-friendly terms: 'About 6 in 10 migraines are missed by predictions.'"},
        {"dimension": "P5.D1", "mitigation": "Show top 3 contributing factors per prediction ('sleep deficit yesterday, weather front coming')."},
        {"dimension": "P6.D5", "mitigation": "Publish a model card with demographic breakdown of training data; flag underrepresented groups."},
        {"dimension": "P7.D1", "mitigation": "Clarify intended purpose: if 'symptom anticipation only' → maybe wellness; if 'inform medication timing' → SaMD path."}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Rule 11", "EU AI Act Annex III §1(a)", "GDPR Art. 9", "MDCG 2019-11"]
    },
    "notes": "ML prediction case — calibration + uncertainty + false-sense-of-security as the key axis. Easy to miss the recall = 41% problem."
  },
  {
    "id": "scenario_06",
    "app_description": "RxBuddy helps elderly users (and their caregivers) manage polypharmacy. Caregiver takes photos of prescription labels, an LLM extracts the medication list, dosage, and frequency. A drug-interaction check against the DrugBank database flags potential issues. We target Switzerland and France, currently available in DE/FR/IT/EN.",
    "app_metadata": {"category": "adherence", "uses_ai": true, "data_sensitivity": "high", "vulnerable_pop": true, "target_markets": ["EU", "CH"], "samd_class_likely": "IIa"},
    "developer_persona": "CTO of a digital-health startup, deeply experienced with medication safety. Aware of regulation but trying to minimize burden.",
    "simulated_answers": {
      "data_collected": "Prescription photos (stored on-device + thumbnail in cloud for OCR retry), extracted med list, dosage schedule, adherence events.",
      "consent_flow": "Caregiver creates account, links to elderly user; separate consent screen for the elderly user (translated, large fonts).",
      "regulatory_status": "We're applying for Class IIa CE marking under MDR. Notified Body engaged.",
      "user_research": "8-month usability study with 40 elderly users + 25 caregivers in a Lausanne care home.",
      "accessibility": "Large fonts, high contrast, voice readback in DE/FR/IT/EN. Tested with users with mild cognitive impairment.",
      "safety_validation": "LLM extraction accuracy 94% on 1500 prescriptions; interaction-check sensitivity 91% vs pharmacist review.",
      "ai_or_algorithm": "GPT-4o for OCR + extraction; DrugBank vector lookup for interactions; rule-based severity scoring.",
      "post_market": "Vigilance reporting workflow set up with Swissmedic and ANSM (France). Active monitoring of extraction failures.",
      "data_sharing": "Pharmacy partners get adherence summaries with patient consent. No advertising.",
      "withdrawal_rights": "Caregiver or elderly user can request export + delete. Audit logs retained 5 years per medical-device rules."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D1", "P1.D2", "P1.D5", "P2.D1", "P2.D6", "P3.D1", "P3.D5", "P4.D3", "P4.D4", "P5.D1", "P5.D4", "P6.D3", "P7.D1", "P7.D2", "P7.D3", "P7.D5"],
      "expected_risks": [
        {"dimension": "P1.D2", "risk": "6% extraction error rate × dangerous combinations = real harm potential; need a hard-stop UI for low-confidence extractions.", "severity": "high"},
        {"dimension": "P3.D1", "risk": "Caregiver controls the account by default; elderly user's right to make decisions about their own medication can be diluted.", "severity": "high"},
        {"dimension": "P3.D5", "risk": "Caregivers may follow LLM-flagged interactions without consulting pharmacist (automation bias).", "severity": "high"},
        {"dimension": "P7.D3", "risk": "GPT-4o is third-party general-purpose AI; under EU AI Act, downstream high-risk integrator obligations apply.", "severity": "high"},
        {"dimension": "P2.D6", "risk": "Elderly users with cognitive impairment — consent capacity must be assessed.", "severity": "high"},
        {"dimension": "P5.D1", "risk": "User must see WHY an interaction is flagged (mechanism, severity, source) not just a warning icon.", "severity": "medium"},
        {"dimension": "P1.D5", "risk": "Prescription photo OCR can fail on handwritten prescriptions or poor lighting; recovery path matters.", "severity": "medium"}
      ],
      "expected_mitigations": [
        {"dimension": "P1.D2", "mitigation": "Confidence-thresholded UI: if extraction confidence < 0.9, force the caregiver to confirm each field; never auto-trust below 0.95 on dose."},
        {"dimension": "P3.D1", "mitigation": "Dual-account model: elderly user owns the data and can revoke caregiver access at any time."},
        {"dimension": "P3.D5", "mitigation": "Interaction alerts include 'consult pharmacist' as the only action button for severity ≥ moderate."},
        {"dimension": "P7.D3", "mitigation": "Document GPT-4o usage in the technical file with provider's GPAI compliance statement; consider on-prem alternative for resilience."},
        {"dimension": "P5.D1", "mitigation": "Interaction detail panel: drug-drug, mechanism, evidence level (DrugBank citation), severity scale 1-5."}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Rule 11", "EU AI Act Annex III §1(a)", "EU AI Act GPAI obligations", "GDPR Art. 9", "Swiss MedDO/ODim", "ISO 82304-2"]
    },
    "notes": "Strong dev team that's already doing many things right — the eval is whether the copilot catches the *remaining* nuanced risks (automation bias, GPAI integration, dual-account)."
  },
  {
    "id": "scenario_07",
    "app_description": "PulseTrack is the companion app for a CE-marked smartwatch that estimates blood pressure from PPG signals. Users see daily readings + a weekly trend report. It auto-shares with the GP via DEP (Switzerland) or via Sécurité Sociale messaging (France). The watch is Class IIa; the app is the data presentation layer.",
    "app_metadata": {"category": "monitoring", "uses_ai": false, "data_sensitivity": "high", "vulnerable_pop": false, "target_markets": ["EU", "CH"], "samd_class_likely": "IIa"},
    "developer_persona": "Mobile developer in a 50-person medical-device company. Trusts the regulatory team's hardware certification, less sure about software-side obligations.",
    "simulated_answers": {
      "data_collected": "BP estimates (systolic/diastolic), heart rate, watch sensor signals, contextual metadata (activity, motion).",
      "consent_flow": "Onboarding asks for DEP/Sécurité Sociale opt-in separately from app usage consent.",
      "regulatory_status": "Watch is CE Class IIa. App alone is Class I as data display. Combined regulation: MDR-compliant per technical file.",
      "user_research": "Clinical study N=200 vs cuff sphygmomanometer; mean error 4 mmHg systolic, 3 mmHg diastolic.",
      "accessibility": "DE/FR/IT/EN. Large-text mode, voiceover compatible.",
      "safety_validation": "Above clinical study + ongoing monthly recalibration tracking.",
      "ai_or_algorithm": "Signal processing pipeline + small regression model (not a deep net). Considered AI for transparency but not generative.",
      "post_market": "Active post-market clinical follow-up. Vigilance reporting to Swissmedic + ANSM.",
      "data_sharing": "DEP / Sécurité Sociale per consent. No advertising. R&D partnership shares aggregated data after IRB approval.",
      "withdrawal_rights": "User can pause sharing per-doctor and globally; full data export available."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D1", "P1.D5", "P2.D1", "P2.D3", "P2.D4", "P4.D1", "P4.D2", "P5.D1", "P5.D2", "P5.D4", "P6.D5", "P7.D2", "P7.D4", "P7.D5"],
      "expected_risks": [
        {"dimension": "P1.D5", "risk": "PPG BP estimation has known limitations: cold extremities, arrhythmias, motion artefacts. Need to communicate this to users + clinicians.", "severity": "high"},
        {"dimension": "P5.D2", "risk": "Mean error 4 mmHg can be enough to flip clinical decision (e.g., target 130/80 vs 135/85); users / GPs may not see the confidence interval.", "severity": "high"},
        {"dimension": "P5.D4", "risk": "Estimated BP must be distinguishable from cuff-measured BP in the GP's interface, especially in DEP.", "severity": "high"},
        {"dimension": "P4.D2", "risk": "DEP integration: data format conformance to HL7 CDA / FHIR + Swiss eHealth profile.", "severity": "medium"},
        {"dimension": "P6.D5", "risk": "N=200 clinical study — was it stratified by skin tone (PPG accuracy differs), age, BMI?", "severity": "medium"},
        {"dimension": "P2.D4", "risk": "Auto-share to GP without granular control (per-reading) is heavy-handed; consider exclusion windows.", "severity": "low"}
      ],
      "expected_mitigations": [
        {"dimension": "P1.D5", "mitigation": "Display known limitations with each reading: 'Tip: this is an estimate. Cold hands, recent exercise, or atrial fibrillation can affect accuracy.'"},
        {"dimension": "P5.D4", "mitigation": "In the GP report, tag each reading as 'PPG-estimated' with the device + firmware version + confidence interval."},
        {"dimension": "P6.D5", "mitigation": "Run a follow-up bias audit by skin tone (Fitzpatrick scale) + age + BMI; publish in model card."},
        {"dimension": "P4.D2", "mitigation": "Conform to IHE PCD-01 device-observation profile, Swiss eHealth IPAG profile."}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Annex II", "ISO 81060-2 (BP devices)", "ISO 82304-2", "GDPR Art. 9", "Swiss eHealth EPDG/LDEP", "HL7 FHIR R4"]
    },
    "notes": "Mature scenario: regulatory basics are done, the eval tests for finer signals (PPG biases, distinction estimated vs cuff, DEP profile conformance)."
  },
  {
    "id": "scenario_08",
    "app_description": "RecoverNow is a recovery companion for people with eating disorders (anorexia and bulimia). Users log meals, urges, and emotions; an AI flags risky patterns (skipped meals streaks, urge spikes) and suggests coping skills from a CBT toolbox. We co-designed it with a clinical team at a French eating-disorder clinic. EU market.",
    "app_metadata": {"category": "mental-health", "uses_ai": true, "data_sensitivity": "high", "vulnerable_pop": true, "target_markets": ["EU"], "samd_class_likely": "IIa"},
    "developer_persona": "Clinical psychologist turned product lead, deeply familiar with the patient population, less so with regulation.",
    "simulated_answers": {
      "data_collected": "Meal logs (free text + structured), urge intensity, emotion tags, weight (optional, hidden by default), photo-based food log (optional).",
      "consent_flow": "Detailed onboarding video + signed consent form (digital). Consent re-confirmed every 6 months.",
      "regulatory_status": "We classified as wellness because risk-flagging is informational. Now reconsidering after legal review.",
      "user_research": "Patient-research-partner panel of 5 users in recovery + 3 clinicians. Continuous co-design.",
      "accessibility": "FR, EN. WCAG 2.1 AA audit pending.",
      "safety_validation": "Risk-flagging algorithm: sensitivity 88%, specificity 80% on labeled 500-case set from clinic.",
      "ai_or_algorithm": "Rule-based + a small LSTM for streak detection. Coping-skill suggestions are from a hand-curated CBT library.",
      "post_market": "Direct clinician review of every flagged risk case. Weekly clinical safety meeting.",
      "data_sharing": "Optional: share log with treating clinician. No other sharing.",
      "withdrawal_rights": "Full deletion on request. We also offer 'pause' mode."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D1", "P1.D2", "P1.D4", "P2.D1", "P2.D5", "P2.D6", "P3.D1", "P3.D2", "P5.D2", "P5.D4", "P6.D3", "P7.D1", "P7.D2", "P7.D3"],
      "expected_risks": [
        {"dimension": "P7.D1", "risk": "Risk-flagging eating-disorder behaviors is diagnostic decision support → SaMD; 'wellness' framing insufficient.", "severity": "high"},
        {"dimension": "P1.D2", "risk": "Weight logging in ED population is itself risky (triggering); the optional/hidden design is good but needs ongoing monitoring.", "severity": "high"},
        {"dimension": "P2.D6", "risk": "ED users are vulnerable (~10% mortality in anorexia); consent must be assessed alongside treating clinician where feasible.", "severity": "high"},
        {"dimension": "P3.D2", "risk": "Streak gamification or urge-tracking can become compulsive in this population.", "severity": "high"},
        {"dimension": "P5.D4", "risk": "AI-generated 'coping suggestion' vs clinician-validated CBT — users must see the distinction.", "severity": "medium"},
        {"dimension": "P1.D4", "risk": "Suggested coping skills may delay seeking clinician help in acute episodes.", "severity": "medium"},
        {"dimension": "P6.D3", "risk": "FR + EN only — Swiss French differs from FR French in idioms around food/body.", "severity": "low"}
      ],
      "expected_mitigations": [
        {"dimension": "P7.D1", "mitigation": "Submit as Class IIa SaMD; intended purpose: support to clinician-led treatment, not standalone diagnostic."},
        {"dimension": "P3.D2", "mitigation": "Remove streak gamification; replace with cumulative non-quantitative progress markers."},
        {"dimension": "P5.D4", "mitigation": "Each suggestion labelled: 'AI-curated' vs 'clinically-reviewed' badge."},
        {"dimension": "P1.D4", "mitigation": "Hard escalation: any 'no meal logged' >24h OR urge ≥9 → push 'contact your clinician now' overlay."}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Rule 11", "EU AI Act Annex III §1(a)", "GDPR Art. 9", "ISO 82304-2", "MDCG 2019-11"]
    },
    "notes": "Vulnerable population scenario. Co-design is strong, but classification + gamification + scope-bleed are the catches."
  },
  {
    "id": "scenario_09",
    "app_description": "DermaScan is a smartphone app that takes a photo of a skin lesion and uses a CNN to classify it as benign, suspicious, or urgent. We market it as a triage aid for primary-care physicians; the GP takes the photo on their phone with informed patient consent. EU + CH. Trained on the ISIC archive.",
    "app_metadata": {"category": "ai-clinical", "uses_ai": true, "data_sensitivity": "high", "vulnerable_pop": false, "target_markets": ["EU", "CH"], "samd_class_likely": "IIa or IIb"},
    "developer_persona": "Dermatology AI startup CTO, technically strong, has consulted with regulatory but eager to launch.",
    "simulated_answers": {
      "data_collected": "Lesion photo, location on body, patient age, sex, Fitzpatrick skin type (optional), GP's clinical impression.",
      "consent_flow": "Patient signs a paper consent at the practice. App stores a flag.",
      "regulatory_status": "Class IIa under MDR Rule 11. CE marking in progress, notified body designated.",
      "user_research": "Usability tested with 30 GPs.",
      "accessibility": "EN, DE, FR, IT. Designed for GP use, not patient-facing.",
      "safety_validation": "External test set of 2000 dermatoscopic images: 90% sensitivity (melanoma), 78% specificity. No prospective study yet.",
      "ai_or_algorithm": "EfficientNet-B4 fine-tuned on ISIC 2020. Calibrated with Platt scaling.",
      "post_market": "Plan: log every prediction + GP's final decision; quarterly performance review.",
      "data_sharing": "Photos stored 5 years for retraining; pseudonymized.",
      "withdrawal_rights": "Patient consent to retain photo for retraining is opt-in separately."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D1", "P1.D2", "P1.D5", "P2.D1", "P2.D5", "P3.D5", "P5.D1", "P5.D2", "P5.D3", "P6.D1", "P6.D3", "P6.D5", "P7.D1", "P7.D2", "P7.D3", "P7.D5"],
      "expected_risks": [
        {"dimension": "P6.D1", "risk": "ISIC is heavily skewed toward Fitzpatrick I-III (light skin). Performance on darker skin tones is likely worse and unmeasured.", "severity": "high"},
        {"dimension": "P3.D5", "risk": "GP may over-rely on the model; 'urgent' classification can drive unnecessary excisions or 'benign' can miss melanomas.", "severity": "high"},
        {"dimension": "P5.D1", "risk": "No explanation visible to GP: just a label. Need at least Grad-CAM or class probability + confidence calibration.", "severity": "high"},
        {"dimension": "P1.D1", "risk": "External test set ≠ prospective study. Need a clinical trial in real GP practice before market.", "severity": "high"},
        {"dimension": "P7.D3", "risk": "EU AI Act Annex III §1(a) high-risk: AI-aided diagnosis. Full obligations apply.", "severity": "high"},
        {"dimension": "P6.D5", "risk": "Reporting validation by skin tone, age, body location is missing from current evidence pack.", "severity": "high"},
        {"dimension": "P5.D3", "risk": "Decision logs proposed for quarterly review — too slow; live monitoring with anomaly detection needed.", "severity": "medium"}
      ],
      "expected_mitigations": [
        {"dimension": "P6.D1", "mitigation": "Augment training data + run a bias audit across Fitzpatrick I-VI; refuse to predict if Fitzpatrick high uncertainty."},
        {"dimension": "P3.D5", "mitigation": "Force the GP to enter their clinical impression BEFORE seeing the AI prediction; show both side-by-side."},
        {"dimension": "P5.D1", "mitigation": "Provide a saliency map per prediction; show top-3 features driving classification."},
        {"dimension": "P1.D1", "mitigation": "Multi-centre prospective study with N≥500 lesions, pre-registered, ground truth = histopathology."},
        {"dimension": "P5.D3", "mitigation": "Real-time monitoring of prediction distribution drift + per-clinic accuracy; auto-page if drift > threshold."}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Rule 11", "EU AI Act Annex III §1(a)", "MDCG 2019-11", "MDCG 2020-1 (clinical evaluation)", "GDPR Art. 9", "ISO 14971 (risk mgmt)"]
    },
    "notes": "AI clinical diagnosis with known skin-tone bias issue + risk of automation bias. Test for bias-aware design + explanation + prospective validation."
  },
  {
    "id": "scenario_10",
    "app_description": "CareAir is an AI radiology assistant for chest X-rays. It runs on the radiologist's workstation, highlights potential nodules and pneumothoraces. It's a second-reader, the radiologist always reviews. CE-marked Class IIa, deployed in 30 hospitals across EU.",
    "app_metadata": {"category": "ai-clinical", "uses_ai": true, "data_sensitivity": "high", "vulnerable_pop": false, "target_markets": ["EU", "CH"], "samd_class_likely": "IIa"},
    "developer_persona": "Clinical AI veteran, very familiar with regulation and clinical evidence requirements.",
    "simulated_answers": {
      "data_collected": "DICOM images (anonymized at hospital before transfer), prediction outputs, radiologist overrides.",
      "consent_flow": "Hospital handles patient consent under their broader use-of-data policies.",
      "regulatory_status": "CE Class IIa. EU AI Act high-risk obligations mapped + documented.",
      "user_research": "Deployed in 3 pilot sites for 1 year before broader rollout.",
      "accessibility": "PACS workstation only; not patient-facing.",
      "safety_validation": "Prospective multi-centre study N=4500; AUROC 0.96 nodules, 0.94 pneumothorax. Radiologist+AI accuracy 4% higher than radiologist alone.",
      "ai_or_algorithm": "Vision Transformer trained on ~1M chest X-rays. Calibrated probabilities. Multilingual report generation.",
      "post_market": "Quarterly drift monitoring, automatic comparison to radiologist final read, vigilance reporting to Swissmedic.",
      "data_sharing": "Hospital data stays within hospital. Aggregated model performance shared with regulator.",
      "withdrawal_rights": "Per-hospital opt-out at any time; no patient-level account."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D2", "P3.D5", "P4.D1", "P4.D2", "P5.D1", "P5.D3", "P5.D4", "P6.D1", "P6.D5", "P7.D3", "P7.D5", "P7.D6", "P7.D7"],
      "expected_risks": [
        {"dimension": "P3.D5", "risk": "Even as second-reader, 'positive' highlights bias the radiologist's read; subtle de-skilling over time.", "severity": "high"},
        {"dimension": "P6.D1", "risk": "1M training images — distribution across hospitals/countries/scanners? Domain shift on new sites.", "severity": "medium"},
        {"dimension": "P5.D3", "risk": "Need radiologist-facing audit trail: which highlights did they accept/reject and why.", "severity": "medium"},
        {"dimension": "P4.D1", "risk": "PACS integration failure modes — if the AI service is down, does the workflow degrade gracefully?", "severity": "medium"},
        {"dimension": "P7.D5", "risk": "Quarterly drift check might miss fast-evolving issues (new scanner model deployed in hospital).", "severity": "medium"},
        {"dimension": "P5.D1", "risk": "Highlights without rationale (location + similar-case retrieval) may lower trust calibration.", "severity": "low"}
      ],
      "expected_mitigations": [
        {"dimension": "P3.D5", "mitigation": "Randomised audit: 5% of cases shown WITHOUT AI highlights to measure radiologist baseline drift."},
        {"dimension": "P6.D1", "mitigation": "Per-site recalibration; document distribution shifts in model card."},
        {"dimension": "P5.D3", "mitigation": "Every prediction logged + radiologist accept/reject + final report → queryable audit."},
        {"dimension": "P4.D1", "mitigation": "Fallback: if AI service unavailable, the workflow continues as standard radiology; clear UI signal."},
        {"dimension": "P7.D5", "mitigation": "Continuous drift monitoring (PSI, KS test on prediction distributions) with auto-page below threshold."}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Rule 11", "EU AI Act Annex III §1(a)", "ISO 13485", "ISO 14971", "MDCG 2020-1"]
    },
    "notes": "Mature deployment scenario — the catches are the second-order issues (automation bias even with humans in the loop, drift monitoring frequency, audit logging granularity)."
  },
  {
    "id": "scenario_11",
    "app_description": "SkinTrack lets patients photograph their moles monthly and stores standardized images. No AI — the app just prompts the photo and shows past photos side-by-side. If size/color changes by more than a threshold, the app suggests booking a dermatologist appointment. EU market.",
    "app_metadata": {"category": "imaging", "uses_ai": false, "data_sensitivity": "high", "vulnerable_pop": false, "target_markets": ["EU"], "samd_class_likely": "Class I"},
    "developer_persona": "Indie founder, dermatology-curious, single-person team.",
    "simulated_answers": {
      "data_collected": "Mole photos (with location, date), user-marked changes, optional symptom notes.",
      "consent_flow": "Onboarding consent screen + data-export demo.",
      "regulatory_status": "We think it's wellness — no diagnosis, just photo logging.",
      "user_research": "No formal user research, just my own usage.",
      "accessibility": "English only. Basic.",
      "safety_validation": "Threshold for 'see a doctor' set arbitrarily at 20% area change. No clinical basis.",
      "ai_or_algorithm": "Just image storage and pixel comparison. Not AI.",
      "post_market": "Crash analytics. No clinical incident workflow.",
      "data_sharing": "Photos stored locally + backup. No third-party sharing.",
      "withdrawal_rights": "Delete account → everything wiped within 7 days."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D1", "P1.D3", "P1.D4", "P1.D5", "P2.D1", "P2.D3", "P4.D3", "P4.D4", "P5.D2", "P6.D2", "P7.D1"],
      "expected_risks": [
        {"dimension": "P7.D1", "risk": "Suggesting a clinical action ('see a dermatologist') based on a threshold = clinical decision support → likely SaMD Class I at minimum.", "severity": "high"},
        {"dimension": "P1.D1", "risk": "20% threshold has no clinical basis; could miss aggressive melanomas or generate false alarms.", "severity": "high"},
        {"dimension": "P1.D3", "risk": "Users may rely on the app's silence as reassurance ('no alert → no problem') and skip routine dermatology check-ups.", "severity": "high"},
        {"dimension": "P1.D5", "risk": "Photo standardization (lighting, angle, distance) is user-dependent → unreliable comparisons.", "severity": "high"},
        {"dimension": "P4.D3", "risk": "English-only excludes most EU users; basic accessibility excludes users with low vision (who are at higher melanoma risk if outdoor workers).", "severity": "medium"},
        {"dimension": "P5.D2", "risk": "Limitations of pixel-comparison not communicated; user assumes it's 'medical-grade'.", "severity": "high"}
      ],
      "expected_mitigations": [
        {"dimension": "P7.D1", "mitigation": "Either remove the threshold-based suggestion (pure photo-log) or pursue Class I SaMD registration with a Notified Body."},
        {"dimension": "P1.D1", "mitigation": "Adopt the ABCDE criteria (Asymmetry, Border, Color, Diameter, Evolution) with documented evidence base instead of 20% threshold."},
        {"dimension": "P1.D5", "mitigation": "Photo guides (overlay grid, lighting tips); use phone gyro to enforce consistent angle."},
        {"dimension": "P5.D2", "mitigation": "Prominent disclaimer: 'This is a photo log, not a medical assessment. Annual dermatology check-ups remain essential.'"}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Rule 11", "MDCG 2019-11", "GDPR Art. 9", "EN ISO 14971"]
    },
    "notes": "Tiny app, big stakes (melanoma = killer). Tests whether the copilot recognises that 'just a threshold' = SaMD."
  },
  {
    "id": "scenario_12",
    "app_description": "Lunara is a menstrual cycle tracker that also offers a fertility prediction mode (for users trying to conceive) and a 'natural contraception' mode that predicts safe vs unsafe days. Algorithm based on basal body temperature + cycle history. We're EU + CH. 4 million users.",
    "app_metadata": {"category": "reproductive", "uses_ai": true, "data_sensitivity": "high", "vulnerable_pop": false, "target_markets": ["EU", "CH"], "samd_class_likely": "IIa"},
    "developer_persona": "Senior PM at a femtech scale-up. Confident, fast-moving.",
    "simulated_answers": {
      "data_collected": "Cycle dates, BBT readings, symptoms, optional partner activity log, mood tracking. We use IDFA for marketing attribution.",
      "consent_flow": "Account creation requires accepting privacy policy. Health data processing in 'sensitive data' onboarding flow.",
      "regulatory_status": "Natural contraception mode is CE Class IIa under MDR. Tracker mode is wellness.",
      "user_research": "Massive ongoing user testing. 12-language localisation.",
      "accessibility": "WCAG 2.1 AA. 12 languages.",
      "safety_validation": "Contraception mode: 6.5 Pearl Index in typical use (clinical study N=1500); 1.8 in perfect use.",
      "ai_or_algorithm": "Bayesian model for ovulation prediction. Uncertainty intervals shown to users.",
      "post_market": "Vigilance reporting; quarterly safety review.",
      "data_sharing": "Aggregated cycle data with research partners (anonymized). No advertising on health data.",
      "withdrawal_rights": "Account delete; data exported as CSV; takeoff GDPR portability."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D1", "P1.D2", "P1.D3", "P2.D1", "P2.D2", "P2.D4", "P2.D6", "P3.D2", "P5.D2", "P5.D4", "P6.D1", "P6.D3", "P7.D1", "P7.D3"],
      "expected_risks": [
        {"dimension": "P1.D2", "risk": "Pearl Index 6.5 in typical use = unintended pregnancy is a major harm; users must understand this clearly.", "severity": "high"},
        {"dimension": "P5.D2", "risk": "'1.8 perfect use' is misleading without context — most users are not perfect.", "severity": "high"},
        {"dimension": "P1.D3", "risk": "Green 'safe day' indicator can give false sense of security.", "severity": "high"},
        {"dimension": "P2.D6", "risk": "Menstrual data + abortion-rights climate in some EU countries → sensitive; data location matters.", "severity": "high"},
        {"dimension": "P2.D4", "risk": "Even aggregated data with anonymization can be re-identified given cycle uniqueness.", "severity": "medium"},
        {"dimension": "P5.D4", "risk": "Tracker mode vs contraception mode distinction must be unmistakable in UI.", "severity": "high"},
        {"dimension": "P6.D1", "risk": "Algorithm assumptions may underperform on PCOS, irregular cycles, post-partum.", "severity": "medium"}
      ],
      "expected_mitigations": [
        {"dimension": "P5.D2", "mitigation": "Display typical-use Pearl Index prominently. Comparison table with IUD/pill in onboarding."},
        {"dimension": "P1.D3", "mitigation": "Replace binary 'safe/unsafe' with continuous risk gradient + explanation."},
        {"dimension": "P2.D6", "mitigation": "Data residency in EU + zero-knowledge encryption option."},
        {"dimension": "P5.D4", "mitigation": "Mode switch requires confirmation modal explaining what changes."},
        {"dimension": "P6.D1", "mitigation": "Detect PCOS markers + irregular cycles → refuse to predict in contraception mode; suggest medical consultation."}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Rule 11", "EU AI Act Annex III §1(a)", "GDPR Art. 9", "ISO 82304-2"]
    },
    "notes": "Femtech case: clinical class IIa already done, but user-facing risk communication + bias on irregular cycles + data politics are the catches."
  },
  {
    "id": "scenario_13",
    "app_description": "ZenSpace is a mindfulness app: guided meditations, breathing exercises, daily mood check-ins. No medical claims. Free tier with optional premium. We sell aggregated wellness data to corporate-wellness programs (e.g., Google, BNP Paribas) showing average mood trends in their cohort.",
    "app_metadata": {"category": "wellness", "uses_ai": false, "data_sensitivity": "low", "vulnerable_pop": false, "target_markets": ["EU"], "samd_class_likely": "wellness"},
    "developer_persona": "Growth-stage SaaS company CTO. Privacy-aware but business-pragmatic.",
    "simulated_answers": {
      "data_collected": "Mood scores (1-5), session usage, optional journal entries, email for login.",
      "consent_flow": "On signup, separate consent toggles for app usage and 'wellness program' data sharing.",
      "regulatory_status": "Wellness, not a medical device. We don't make medical claims.",
      "user_research": "Continuous A/B testing.",
      "accessibility": "8 EU languages; WCAG 2.1 AA partially.",
      "safety_validation": "No clinical claims so no validation needed.",
      "ai_or_algorithm": "No AI.",
      "post_market": "App store reviews monitored.",
      "data_sharing": "Aggregated wellness data sold to corporate wellness programs. Individual data never sold.",
      "withdrawal_rights": "Account delete in settings."
    },
    "gold_standard": {
      "relevant_dimensions": ["P2.D1", "P2.D2", "P2.D3", "P2.D4", "P2.D5", "P3.D2", "P4.D3", "P5.D2", "P6.D2", "P6.D4"],
      "expected_risks": [
        {"dimension": "P2.D4", "risk": "'Aggregated' wellness data sold to employer-linked corporate program can be re-identified if cohort is small (e.g., team of 20).", "severity": "high"},
        {"dimension": "P2.D1", "risk": "Workplace context: 'consent' under employer-sponsored wellness is often coerced (people fear opting out).", "severity": "high"},
        {"dimension": "P2.D5", "risk": "Anonymization standard (k-anonymity? differential privacy?) not specified.", "severity": "medium"},
        {"dimension": "P3.D2", "risk": "Gamification (streaks, badges) could be problematic if linked to corporate KPIs.", "severity": "medium"},
        {"dimension": "P5.D2", "risk": "Users may believe 'aggregated' data is fully anonymized — it usually isn't.", "severity": "medium"},
        {"dimension": "P6.D4", "risk": "Corporate wellness programs reach already-employed, already-resourced populations; widens the gap with workers in precarious employment without such benefits.", "severity": "medium"}
      ],
      "expected_mitigations": [
        {"dimension": "P2.D4", "mitigation": "Set minimum aggregation cohort (e.g., 50+ employees); add Laplace noise + audit before release."},
        {"dimension": "P2.D1", "mitigation": "Employer must not know who opted out; aggregation runs only on a population basis."},
        {"dimension": "P3.D2", "mitigation": "Decouple gamification from any corporate-program metric; user dashboards only."},
        {"dimension": "P5.D2", "mitigation": "Privacy notice explaining the limits of aggregation, k-threshold, who receives data."}
      ],
      "expected_regulations_cited": ["GDPR Art. 9", "GDPR Art. 6(1)(a)", "Art. 29 WP Opinion 5/2014 (anonymization)", "GDPR Art. 22"]
    },
    "notes": "Looks low-risk because 'wellness', but corporate-wellness data monetization is the real risk axis."
  },
  {
    "id": "scenario_14",
    "app_description": "SleepWell is an iOS/Android app that stages your sleep using phone microphone + accelerometer, and delivers a CBT-I (insomnia) coaching programme over 6 weeks. The coaching content is personalised by a small ML model based on user adherence and reported sleep. EU.",
    "app_metadata": {"category": "wellness", "uses_ai": true, "data_sensitivity": "medium", "vulnerable_pop": false, "target_markets": ["EU"], "samd_class_likely": "Class I or IIa"},
    "developer_persona": "Sleep researcher founder. Thinks scientifically but is new to medical-device regulation.",
    "simulated_answers": {
      "data_collected": "Microphone (continuous during sleep, kept on-device + a digest sent to cloud), accelerometer, sleep diary, CBT-I exercise completion.",
      "consent_flow": "Onboarding video explaining how the microphone is used; separate consent.",
      "regulatory_status": "Wellness coaching, not SaMD. We don't diagnose insomnia.",
      "user_research": "Beta tested with 200 users.",
      "accessibility": "EN, DE, FR.",
      "safety_validation": "Sleep staging accuracy ~80% vs polysomnography (in-lab study N=50).",
      "ai_or_algorithm": "CNN for sleep staging from audio + motion; rule-based CBT-I prescription engine.",
      "post_market": "Crash analytics + monthly retention review.",
      "data_sharing": "No third parties. Aggregated for research with university partnership.",
      "withdrawal_rights": "Account delete; microphone digest data is auto-deleted after 30 days."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D1", "P1.D5", "P2.D1", "P2.D2", "P2.D3", "P3.D1", "P4.D5", "P5.D1", "P5.D2", "P5.D4", "P7.D1", "P7.D3"],
      "expected_risks": [
        {"dimension": "P2.D1", "risk": "Continuous microphone access requires explicit, granular consent + clear explanation of on-device processing.", "severity": "high"},
        {"dimension": "P2.D2", "risk": "Audio digest in cloud — what does it contain? Spectrograms can leak speech.", "severity": "high"},
        {"dimension": "P7.D1", "risk": "CBT-I delivery for insomnia (a clinical condition) → arguable SaMD; 'coaching' framing may not hold.", "severity": "medium"},
        {"dimension": "P1.D1", "risk": "Sleep staging 80% vs PSG is okay-ish but CBT-I efficacy not validated in app form.", "severity": "medium"},
        {"dimension": "P5.D1", "risk": "Personalised coaching: user should know which signals drove a recommendation.", "severity": "medium"},
        {"dimension": "P1.D5", "risk": "Accelerometer + audio sleep staging is environment-sensitive (partner, pets).", "severity": "medium"}
      ],
      "expected_mitigations": [
        {"dimension": "P2.D1", "mitigation": "Permission rationale screen + sample audio digest preview; explain on-device vs cloud split."},
        {"dimension": "P2.D2", "mitigation": "Audio digest = spectrogram bins of motion bands only; no speech-band signal leaves device."},
        {"dimension": "P7.D1", "mitigation": "Engage regulator early; map to MDR Rule 11 ; if framing 'support adherence to CBT-I' rather than 'deliver CBT-I', might stay below."},
        {"dimension": "P1.D1", "mitigation": "Single-arm pilot with ISI (Insomnia Severity Index) pre/post on 50 users; publish in model card."}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Rule 11", "GDPR Art. 9", "EU AI Act Annex III §1(a)", "ISO 82304-2"]
    },
    "notes": "Continuous microphone + clinical condition = classic privacy + classification dual risk."
  },
