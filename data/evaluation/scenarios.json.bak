  {
    "id": "scenario_16",
    "app_description": "MediCall is a teleconsultation app: video calls with licensed GPs, e-prescription, secure messaging, integration with national eHealth records (DEP in Switzerland, DMP in France). Available 24/7. Doctors are employees, not partners.",
    "app_metadata": {"category": "telemedicine", "uses_ai": false, "data_sensitivity": "high", "vulnerable_pop": false, "target_markets": ["EU", "CH"], "samd_class_likely": "Class I"},
    "developer_persona": "Engineering lead at a 200-person telehealth provider. Compliance-aware, mature processes.",
    "simulated_answers": {
      "data_collected": "Account info, consultation transcripts, video recordings (if user consents), prescriptions, payment, eHealth pull from DEP/DMP.",
      "consent_flow": "Staged consent: app usage → video recording → eHealth integration → each as a separate decision.",
      "regulatory_status": "Class I medical device for the prescription module. eHealth integration certified per national rules.",
      "user_research": "Continuous; doctor + patient UX research.",
      "accessibility": "DE, FR, IT, EN; sign-language interpreter available on request.",
      "safety_validation": "Annual clinical audit; doctors are board-certified and audited.",
      "ai_or_algorithm": "No AI in clinical pathway. Translation uses Google Cloud Translate (off-clinical text only).",
      "post_market": "Incident management workflow + vigilance reporting.",
      "data_sharing": "Patient owns the data; consultations shared only per patient consent.",
      "withdrawal_rights": "Account delete; data retention per medical-records law (10 years CH, 20 years FR)."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D2", "P2.D1", "P2.D3", "P2.D4", "P2.D5", "P3.D1", "P3.D3", "P4.D1", "P4.D2", "P4.D3", "P5.D2", "P5.D3", "P7.D2", "P7.D4", "P7.D7"],
      "expected_risks": [
        {"dimension": "P2.D5", "risk": "Medical-records retention (10/20 yr) collides with GDPR right to erasure; retention basis must be documented per Art. 17(3)(b).", "severity": "medium"},
        {"dimension": "P2.D3", "risk": "Video recordings of consultations = exceptionally sensitive; cross-border storage choice matters.", "severity": "high"},
        {"dimension": "P3.D3", "risk": "Doctor-patient relationship can be more transactional via app; continuity of care?", "severity": "medium"},
        {"dimension": "P3.D1", "risk": "Patient's freedom to choose doctor — does the app rotate doctors or guarantee continuity?", "severity": "medium"},
        {"dimension": "P4.D1", "risk": "Video failure during prescription consult is a clinical risk; need fallback (phone).", "severity": "medium"},
        {"dimension": "P4.D2", "risk": "DEP / DMP profile conformance + audit trail; healthcare exchange formats.", "severity": "medium"},
        {"dimension": "P2.D4", "risk": "Google Translate is data sharing — even 'off-clinical' text can leak PHI.", "severity": "medium"}
      ],
      "expected_mitigations": [
        {"dimension": "P2.D5", "mitigation": "Retention policy documented as legal obligation; erasure requests handled per Art. 17(3)(b)."},
        {"dimension": "P2.D3", "mitigation": "Recordings encrypted at rest with patient-specific key; minimum retention; CH/EU residency."},
        {"dimension": "P3.D3", "mitigation": "Patient can request 'same doctor on next call' as default."},
        {"dimension": "P4.D1", "mitigation": "Automatic phone fallback if video drops; consultation can resume."},
        {"dimension": "P4.D2", "mitigation": "Conformance to IHE XDS / Swiss EPDG profile; per-call audit log."},
        {"dimension": "P2.D4", "mitigation": "Self-host translation (e.g., NLLB on prem) for any PHI-adjacent content."}
      ],
      "expected_regulations_cited": ["MDR 2017/745", "GDPR Art. 9", "GDPR Art. 17(3)(b)", "Swiss EPDG/LDEP", "French L1110-4 (medical secrecy)", "ePrivacy Directive"]
    },
    "notes": "Strong tele-medicine setup; the eval is about catching the subtle cross-border, fallback, and continuity-of-care risks."
  },
  {
    "id": "scenario_17",
    "app_description": "MindCare is a mental-health teleconsultation with licensed psychotherapists. In-app journaling between sessions, AI-summarised journal previews visible to the therapist. EU + CH. Available in DE, FR, IT, EN.",
    "app_metadata": {"category": "telemedicine", "uses_ai": true, "data_sensitivity": "high", "vulnerable_pop": true, "target_markets": ["EU", "CH"], "samd_class_likely": "Class I/IIa"},
    "developer_persona": "Product lead with a clinical psychology background, sensitive to therapeutic alliance.",
    "simulated_answers": {
      "data_collected": "Journal entries, AI-summaries shown to therapist, session video (optional), mood ratings, therapist notes.",
      "consent_flow": "Three layers: app, AI summary visibility, recording.",
      "regulatory_status": "Class I for the journaling, awaiting determination on the AI summary feature.",
      "user_research": "Co-designed with a psychotherapy association.",
      "accessibility": "WCAG; DE/FR/IT/EN.",
      "safety_validation": "Clinical audit of therapists; AI summary fidelity measured monthly on a sample.",
      "ai_or_algorithm": "Mistral-Large summarisation; outputs reviewed by user before therapist sees them.",
      "post_market": "Active therapeutic-alliance survey at 4-week mark.",
      "data_sharing": "Therapist sees what user shares; no third parties.",
      "withdrawal_rights": "User can delete journal entries before therapist views; revoke AI summary for any session."
    },
    "gold_standard": {
      "relevant_dimensions": ["P2.D1", "P2.D3", "P2.D6", "P3.D1", "P3.D2", "P3.D3", "P3.D4", "P5.D2", "P5.D3", "P5.D4", "P7.D1", "P7.D3"],
      "expected_risks": [
        {"dimension": "P3.D3", "risk": "AI-summarised journal can subtly substitute for the therapist's direct reading; risk to therapeutic alliance.", "severity": "high"},
        {"dimension": "P5.D4", "risk": "User must distinguish what was their own writing vs the AI summary in any export or therapist UI.", "severity": "high"},
        {"dimension": "P3.D4", "risk": "Right to withdraw AI summary must be granular and easy.", "severity": "medium"},
        {"dimension": "P5.D2", "risk": "AI summary may misrepresent (omit, exaggerate); fidelity must be measurable, not just measured by sample.", "severity": "high"},
        {"dimension": "P2.D6", "risk": "Mental-health journals are deeply sensitive; account access policies (password reset, family override) need to be conservative.", "severity": "medium"},
        {"dimension": "P7.D1", "risk": "AI summary feature delivering content to a therapist about a patient = arguable SaMD (clinical decision support).", "severity": "medium"}
      ],
      "expected_mitigations": [
        {"dimension": "P3.D3", "mitigation": "Therapist sees both: raw journal + AI summary, with summary explicitly flagged."},
        {"dimension": "P5.D4", "mitigation": "AI summary in distinct visual style with attribution; never paste it into the therapist's note without attribution."},
        {"dimension": "P5.D2", "mitigation": "User reviews and edits every AI summary before therapist sees it."},
        {"dimension": "P3.D4", "mitigation": "Per-session 'don't summarise this' toggle; revoke past summaries."}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Rule 11", "EU AI Act Annex III §1(a)", "GDPR Art. 9", "Beauchamp & Childress (Autonomy)"]
    },
    "notes": "Therapeutic alliance + AI hand-off case. Tests for distinction between AI and human content."
  },
  {
    "id": "scenario_18",
    "app_description": "MindBoost is a cognitive rehab tool for elderly post-stroke or early dementia. Game-based exercises set by their physiotherapist; progress reviewed by clinician. We target Swiss + German nursing homes and home-care.",
    "app_metadata": {"category": "rehabilitation", "uses_ai": false, "data_sensitivity": "medium", "vulnerable_pop": true, "target_markets": ["EU", "CH"], "samd_class_likely": "IIa"},
    "developer_persona": "Co-founder, geriatric neurorehab background.",
    "simulated_answers": {
      "data_collected": "Exercise results (accuracy, response time), session frequency, clinician notes.",
      "consent_flow": "Caregiver/clinician onboards patient; patient consent assessed where capacity exists.",
      "regulatory_status": "Class IIa MDR. CE marking in progress.",
