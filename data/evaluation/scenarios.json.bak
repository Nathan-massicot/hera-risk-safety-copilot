      "ai_or_algorithm": "No AI.",
      "post_market": "Annual safety review with clinical advisory board.",
      "data_sharing": "Within the care team only; with family on consent.",
      "withdrawal_rights": "Patient or guardian can withdraw."
    },
    "gold_standard": {
      "relevant_dimensions": ["P2.D1", "P2.D6", "P3.D1", "P4.D3", "P4.D4", "P5.D2", "P6.D2", "P6.D3", "P7.D1", "P7.D2"],
      "expected_risks": [
        {"dimension": "P2.D6", "risk": "Patients with cognitive impairment may not have capacity for fully informed consent — assessment required.", "severity": "high"},
        {"dimension": "P3.D1", "risk": "Family/caregiver-driven sign-up can dilute the patient's autonomy; check capacity at each session.", "severity": "medium"},
        {"dimension": "P4.D3", "risk": "Large fonts + voice are good; what about hearing-impaired or motor-impaired users?", "severity": "medium"},
        {"dimension": "P4.D4", "risk": "Older users can find game UI condescending or confusing; iterative UCD needed.", "severity": "medium"},
        {"dimension": "P6.D3", "risk": "German variants (CH-DE, AT-DE) differ; idioms must be checked with local clinicians.", "severity": "low"},
        {"dimension": "P5.D2", "risk": "Small RCT (N=80) effects may not generalise; clinicians must see effect sizes.", "severity": "low"}
      ],
      "expected_mitigations": [
        {"dimension": "P2.D6", "mitigation": "Document capacity assessment workflow; advance directive when capacity declines."},
        {"dimension": "P4.D3", "mitigation": "Closed-captions for voice; large hit targets; alternative input (eye-tracking?)."},
        {"dimension": "P3.D1", "mitigation": "Patient-facing 'today I don't want to play' option respected unconditionally."},
        {"dimension": "P5.D2", "mitigation": "Clinician dashboard shows effect-size + CI; not just 'improvement'."}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Rule 11", "GDPR Art. 7 (consent)", "GDPR Art. 9", "Beauchamp & Childress", "Swiss MedDO"]
    },
    "notes": "Vulnerable population, careful dev — tests for fine-grained capacity + accessibility + UCD signals."
  },
  {
    "id": "scenario_19",
    "app_description": "Anchor is a recovery companion for substance-use disorder: substance log, relapse-risk score, anonymous peer-support chat, optional integration with addiction clinics. EU + CH. Strict privacy posture — many users fear employer or insurer learning of use.",
    "app_metadata": {"category": "mental-health", "uses_ai": false, "data_sensitivity": "high", "vulnerable_pop": true, "target_markets": ["EU", "CH"], "samd_class_likely": "Class I"},
    "developer_persona": "Founder, recovery-services veteran.",
    "simulated_answers": {
      "data_collected": "Substance log (type, quantity, time), urge log, relapse-risk inputs, anonymous chat (pseudonym), clinic referral choice.",
      "consent_flow": "Sign-up with pseudonym; email optional and only for password reset.",
      "regulatory_status": "Class I; relapse-risk score informational.",
      "user_research": "Patient advisory board of 6 in recovery + 3 clinicians.",
      "accessibility": "DE, FR, IT, EN; low-literacy mode.",
      "safety_validation": "Relapse-risk score: 5-feature model from published research; not a 'clinical' decision support.",
      "ai_or_algorithm": "Score is rule-based; chat is human-moderated.",
      "post_market": "Crisis-keyword monitoring + on-call moderator workflow.",
      "data_sharing": "None outside the app; clinic integration only on opt-in with explicit consent.",
      "withdrawal_rights": "Pseudonymous: account delete wipes everything; export available before delete."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D4", "P2.D1", "P2.D2", "P2.D3", "P2.D5", "P2.D6", "P3.D2", "P5.D2", "P6.D2", "P7.D4"],
      "expected_risks": [
        {"dimension": "P2.D3", "risk": "Substance-use data is highly stigma-sensitive; threat model includes phone seizure, employer audit.", "severity": "high"},
        {"dimension": "P2.D2", "risk": "Any non-essential data (precise timestamps, location) is leakage; consider coarse logging.", "severity": "high"},
        {"dimension": "P1.D4", "risk": "Relapse-risk score may delay seeking professional help; clear escalation path needed.", "severity": "high"},
        {"dimension": "P2.D6", "risk": "Many users will be in legal jeopardy (illegal substances); legal safeguards beyond GDPR.", "severity": "high"},
        {"dimension": "P2.D1", "risk": "Pseudonymous sign-up is great; need to make consent text accessible to addiction-recovery population.", "severity": "medium"},
        {"dimension": "P3.D2", "risk": "Gamification of 'sober streaks' can backfire after relapse; design carefully.", "severity": "medium"}
      ],
      "expected_mitigations": [
        {"dimension": "P2.D3", "mitigation": "End-to-end encryption with user-only key; lockdown mode (PIN, panic-wipe)."},
        {"dimension": "P2.D2", "mitigation": "Log day-bucket and dose category, not exact time; never log location."},
        {"dimension": "P1.D4", "mitigation": "Risk score above threshold → mandatory 'call your sponsor / hotline' overlay."},
        {"dimension": "P3.D2", "mitigation": "Streaks reset gently; relapse recorded as a 'learning event', not failure."}
      ],
      "expected_regulations_cited": ["GDPR Art. 9", "GDPR Art. 6", "Swiss BetmG (narcotics)", "MDR 2017/745 Rule 11"]
    },
    "notes": "Threat-model-aware design case. Strong on privacy, the eval is about catching the subtleties (location, gamification, legal risk)."
  },
  {
    "id": "scenario_20",
    "app_description": "BabyCheck delivers the Edinburgh Postnatal Depression Scale (EPDS) weekly post-birth and flags scores ≥10 with a recommendation to contact the midwife or GP. Integrated with maternity-clinic platforms. EU + CH.",
    "app_metadata": {"category": "mental-health", "uses_ai": false, "data_sensitivity": "high", "vulnerable_pop": true, "target_markets": ["EU", "CH"], "samd_class_likely": "IIa"},
    "developer_persona": "Co-founder, midwife by background.",
    "simulated_answers": {
      "data_collected": "EPDS responses, mother name (optional), birth date, contact preferences.",
      "consent_flow": "Detailed consent + capacity note; partner involvement opt-in.",
      "regulatory_status": "Class IIa SaMD under MDR Rule 11. CE marking in progress.",
      "user_research": "Co-developed with 4 maternity clinics; tested with 250 mothers.",
      "accessibility": "WCAG; DE/FR/IT/EN; low-literacy mode.",
      "safety_validation": "EPDS validated in PPD; we use the published cutoff (10).",
      "ai_or_algorithm": "Score calculation only; no AI.",
      "post_market": "Vigilance reporting; clinical advisory board meets quarterly.",
      "data_sharing": "With midwife or GP per opt-in; otherwise on-device.",
      "withdrawal_rights": "User can pause assessments; account delete wipes everything."
    },
    "gold_standard": {
      "relevant_dimensions": ["P1.D1", "P1.D2", "P1.D4", "P2.D1", "P2.D6", "P3.D1", "P3.D2", "P5.D2", "P5.D3", "P7.D1", "P7.D2"],
      "expected_risks": [
        {"dimension": "P1.D2", "risk": "EPDS Q10 asks about self-harm; flagged scores must trigger an immediate human-in-the-loop response, not just a recommendation.", "severity": "high"},
        {"dimension": "P1.D4", "risk": "False reassurance from a sub-threshold score; PPD can present with low EPDS.", "severity": "high"},
        {"dimension": "P5.D2", "risk": "Users must understand EPDS limitations (it's a screen, not a diagnosis).", "severity": "high"},
        {"dimension": "P3.D2", "risk": "Push notifications + weekly assessment can be triggering for mothers struggling.", "severity": "medium"},
        {"dimension": "P2.D6", "risk": "Postpartum mothers are sleep-deprived; consent flows must be re-confirmable.", "severity": "medium"},
        {"dimension": "P5.D3", "risk": "If clinician integration fails (offline), user should see explicit fallback steps.", "severity": "medium"}
      ],
      "expected_mitigations": [
        {"dimension": "P1.D2", "mitigation": "Q10 answered with concern → mandatory human contact: in-app hotline call button + clinician page within 2 minutes."},
        {"dimension": "P1.D4", "mitigation": "Sub-threshold scores with worsening trend also trigger clinician review."},
        {"dimension": "P5.D2", "mitigation": "Plain-language explainer: 'EPDS is a screen, not a diagnosis; talk to your midwife if anything feels off.'"},
        {"dimension": "P3.D2", "mitigation": "Allow flexible scheduling; never aggressive reminders; respect 'too overwhelmed' opt-out."}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Rule 11", "EPDS evidence base (Cox 1987)", "GDPR Art. 9", "Beauchamp & Childress"]
    },
    "notes": "Strong dev team; risk-axes are the suicide-ideation question (Q10), false reassurance, and pregnancy-specific consent flows."
  },
  {
    "id": "scenario_21",
