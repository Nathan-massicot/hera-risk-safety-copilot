      ],
      "expected_mitigations": [
        {"dimension": "P2.D6", "mitigation": "Age verification + parental consent flow + ICO/CNPD-compliant child consent; document data-protection impact assessment (DPIA)."},
        {"dimension": "P3.D2", "mitigation": "Replace adherence 'streaks' with controller-medication 'plan completion' badges; avoid rescue-inhaler counters as positive metric."},
        {"dimension": "P3.D1", "mitigation": "Child-mode UI with age-appropriate view; explicit 'my data' section for ages 12+."},
        {"dimension": "P1.D2", "mitigation": "Personalized over-use threshold based on baseline + season; alert escalation to pulmonologist (not just parent)."}
      ],
      "expected_regulations_cited": ["MDR 2017/745 Rule 11", "GDPR Art. 8 (child consent)", "GDPR Art. 9", "ICO age-appropriate design code", "ISO 82304-2"]
    },
    "notes": "Paediatric scenario: child + parent consent + gamification + autonomy at 12+."
  },
